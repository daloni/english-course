# Public site URL, used by the canonical link and og:url
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Site identity, shown in the title template and the share cards
NUXT_PUBLIC_SITE_NAME=Aprender inglés
NUXT_PUBLIC_SITE_DESCRIPTION=Plataforma personal para aprender inglés: teoría de los tiempos verbales, verbos, frases, reading y speaking.
# Login gate. The password travels as its SHA-256 hex digest, never in plain text
NUXT_PUBLIC_AUTH_USER=alumno
NUXT_PUBLIC_AUTH_PASSWORD_HASH=6bbd88e8c327bb10d12f274a514e1c87024f4971fa724bdcd752271f2873b953
# Cloudflare's testing sitekey: always passes, so dev and CI work without an account
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
