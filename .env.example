# Public site URL, used by the canonical link and og:url
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Site identity, shown in the title template and the share cards
NUXT_PUBLIC_SITE_NAME=Aprender inglés
NUXT_PUBLIC_SITE_DESCRIPTION=Plataforma personal para aprender inglés: teoría de los tiempos verbales, verbos, frases, reading y speaking.
NUXT_PUBLIC_LEGAL_OWNER=Nombre y apellidos del titular
NUXT_PUBLIC_LEGAL_EMAIL=contacto@example.com
# Optional: Google Search Console verification token (meta google-site-verification)
# NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
